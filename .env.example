ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
DAYTONA_API_KEY=
RUNLOOP_API_KEY=
LOCAL_LLM_HOST=localhost
LOCAL_LLM_PORT=30000 # Default for vLLM/llama.cpp; Use 11434 for Ollama

# Meta-Harness Configuration
META_HARNESS_MODEL=deepseek/deepseek-v4-pro
META_HARNESS_ITERATIONS=20
META_HARNESS_TIMEOUT=2400
META_HARNESS_LOGS_DIR=logs
META_HARNESS_FRESH=false
META_HARNESS_SKIP_BASELINE=false

# Hermes Configuration
HERMES_PROPOSER_MODEL=deepseek/deepseek-v4-flash
HERMES_AGENT_PATH=~/.hermes/hermes-agent
HERMES_CONFIG_PATH=~/.hermes/config.yaml
HERMES_ENV_PATH=~/.hermes/.env
